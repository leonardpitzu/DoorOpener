# DoorOpener Dev Environment
# Copy to .env and customise

# Web server port (default: 6532)
DOOROPENER_PORT=6532

# Timezone
TZ=UTC

# Flask session secret, 16+ characters (recommended). Generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Left empty, a random key is used and logins end at every restart.
FLASK_SECRET_KEY=

# Set true when behind HTTPS reverse proxy
SESSION_COOKIE_SECURE=false
