# Secrets and runtime state.
# options.json holds ha_token, admin_password and secret_key; users.json holds
# the per-user PINs. Both are written to /data by the add-on at runtime and are
# only ever created locally for development. The tracked *.example templates are
# untouched by these exact-name patterns.
options.json
users.json
users.json.*
.env
logs/
*.log

# Agent memory (local only — never publish)
AGENTS.md
CLAUDE.md
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# Regenerated by the test and lint tooling
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local Docker overrides (docker-compose.yml itself is tracked)
docker-compose.override.yml

# Editors and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
