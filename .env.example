# DoorOpener standalone container: copy to .env and adjust. All optional.

# The door's time zone. Schedules and guests' dates are read in it, so set it
# to where the door is (Europe/Bucharest, America/New_York, ...). Default UTC.
TZ=UTC

# Port the keypad listens on, inside the container and on the host (default 6532).
DOOROPENER_PORT=6532

# The user the container runs as: yours, so the files in ./data are yours.
# Find them with `id -u` and `id -g`. Default 1000.
PUID=1000
PGID=1000

# Session signing key, 16+ characters. Leave it empty: docker-compose.yml keeps
# a generated one in ./data/secret_key, so logins survive restarts. Set one only
# to share it between containers. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=
