# DoorOpener Dev Environment
# Copy to .env and customise

# Web server port (default: 6532)
DOOROPENER_PORT=6532

# Timezone
TZ=UTC

# Flask session secret, 16+ characters. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Or leave it empty and name a persistent file DoorOpener creates the key in
# (DOOROPENER_SECRET_KEY_FILE). With neither, a random key is used and logins
# end at every restart.
FLASK_SECRET_KEY=
# DOOROPENER_SECRET_KEY_FILE=/app/logs/secret_key

# The session cookie is HTTPS-only whenever a request arrives over HTTPS:
# DoorOpener's own ("ssl": true), or a reverse proxy's when trusted_proxies is set.
